{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Tradewell Plumbing demo",
    "author": "ProsperTechnology",
    "description": "Tradewell by Prosper Technologies"
  },
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/ProsperTechnology/tradewell-demo/main/tradewell.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/ProsperTechnology/tradewell-demo/main/tradewell-leads.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_set_current_user( 1 ); delete_transient( 'twleads_activation_redirect' ); twleads_run_setup( 'plumbing', array( 'business_name' => 'Clearflow Plumbing', 'phone' => '(555) 010-0199', 'city' => 'Springfield' ) ); flush_rewrite_rules(); update_user_meta( 1, 'show_admin_bar_front', 'false' ); wp_set_current_user( 0 );"
    }
  ],
  "login": false
}
